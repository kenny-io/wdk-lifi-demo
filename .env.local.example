# ── LI.FI API (optional — increases rate limits) ─────────────────────────────
# Never expose LIFI_API_KEY client-side. Only read by server-side API routes.
LIFI_API_KEY=
LIFI_INTEGRATOR=

# ── Bridge blacklist (optional) ───────────────────────────────────────────────
# Comma-separated bridge names to exclude from all quotes.
# Example: LIFI_DENY_BRIDGES=across,mayan
LIFI_DENY_BRIDGES=

# ── Server-side wallet (optional) ─────────────────────────────────────────────
# The main UI uses MetaMask for all signing — these are only needed for the
# legacy server-side /api/bridge route (not used by default).
SEED_PHRASE=
RPC_URL=
